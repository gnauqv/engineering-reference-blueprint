# ==============================================================================
# DOCKERFILE BACKEND (NODE.JS / PYTHON / JAVA MẪU)
# ==============================================================================

FROM node:20-alpine
WORKDIR /app

# Khai báo môi trường chạy
ENV NODE_ENV=production

# Copy và cài đặt thư viện chỉ dùng cho production (bỏ devDependencies)
COPY package*.json ./
RUN npm ci --only=production

# Copy toàn bộ mã nguồn
COPY . .

# Mở cổng ứng dụng lắng nghe
EXPOSE 8000

# Lệnh khởi chạy ứng dụng
CMD ["npm", "start"]
