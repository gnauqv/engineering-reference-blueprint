# ============================================================

# Backend Environment Variables

#

# MỤC ĐÍCH:

# - Document các configuration backend cần thiết.

# - Không chứa secret thật.

# - Điều chỉnh theo framework, database và infrastructure

# của project thực tế.

# ============================================================

# ------------------------------------------------------------

# Application

# ------------------------------------------------------------

APP_NAME=my-backend
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=4000

# ------------------------------------------------------------

# Database

# ------------------------------------------------------------

DATABASE_URL=change-me

# Nếu project không sử dụng DATABASE_URL,

# có thể thay bằng các biến riêng:

#

# DB_HOST=localhost

# DB_PORT=5432

# DB_NAME=app

# DB_USER=app

# DB_PASSWORD=change-me

# ------------------------------------------------------------

# Authentication

# ------------------------------------------------------------

JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# ------------------------------------------------------------

# CORS

# ------------------------------------------------------------

CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------

# External Services

# ------------------------------------------------------------

# Ví dụ:

# REDIS_URL=redis://localhost:6379

# STORAGE_URL=

# STORAGE_ACCESS_KEY=

# STORAGE_SECRET_KEY=

# ------------------------------------------------------------

# Notes

# ------------------------------------------------------------

# Không commit secret thật vào Git.

#

# Sau khi migrate:

# 1. Giữ các biến thực sự được sử dụng.

# 2. Xóa các biến không cần.

# 3. Cập nhật README nếu thêm configuration quan trọng.
