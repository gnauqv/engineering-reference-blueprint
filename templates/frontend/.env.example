# ============================================================

# Frontend Environment Variables

#

# MỤC ĐÍCH:

# - Danh sách các environment variables frontend cần có.

# - Không chứa secret thật.

# - Copy thành .env.local / .env khi tạo project thực tế.

# ============================================================

# ------------------------------------------------------------

# API

# ------------------------------------------------------------

# URL của Backend API.

VITE_API_URL=http://localhost:4000

# ------------------------------------------------------------

# Application

# ------------------------------------------------------------

# Frontend application name.

VITE_APP_NAME=My Application

# Frontend application environment.

VITE_APP_ENV=development

# ------------------------------------------------------------

# Authentication

# ------------------------------------------------------------

# Public configuration nếu authentication provider yêu cầu.

# Không đặt client secret vào frontend.

# VITE_AUTH_CLIENT_ID=

# ------------------------------------------------------------

# Notes

# ------------------------------------------------------------

# Không commit:

# - API secret

# - Private key

# - Database password

# - JWT secret

# - OAuth client secret

#

# Secret phải được lưu trong environment của deployment platform.
